[
  {
    "key": "account_compliant",
    "type": "choice",
    "instructions": "判断该账户开立流程是否符合公司合规政策。",
    "criteria": {
      "compliant": "所有开户文件齐全，KYC/AML 验证通过，适当性评估完成，Form ADV 已披露",
      "non-compliant": "缺少必要文件或验证步骤，存在明显违规",
      "needs-review": "处于灰色地带，需要人工复核"
    },
    "facts": {
      "field": "account_opening.status",
      "rule": {
        "op": "identity"
      }
    },
    "policy_keywords": [
      "Account Opening",
      "KYC",
      "Form ADV"
    ]
  },
  {
    "key": "aml_high_risk",
    "type": "noul",
    "instructions": "判断该客户是否构成高洗钱风险。",
    "criteria": {
      "true": "存在多项 AML 红旗指标",
      "false": "无显著 AML 风险"
    },
    "facts": {
      "field": "risk_indicators.aml_flags",
      "rule": {
        "op": "count_gte",
        "value": 2
      }
    },
    "policy_keywords": [
      "Anti Money Laundering",
      "KYC"
    ]
  },
  {
    "key": "suitability_score",
    "type": "score",
    "instructions": "评估投资建议与客户需求及风险承受能力的匹配程度。",
    "criteria": [
      "完全不匹配",
      "部分匹配但存在重大偏差",
      "基本匹配",
      "完全匹配"
    ],
    "facts": {
      "field": "investment.suitability_level",
      "rule": {
        "op": "map",
        "mapping": {
          "none": 0,
          "partial": 1,
          "basic": 2,
          "full": 3
        }
      }
    },
    "policy_keywords": [
      "Suitability",
      "Portfolio Management"
    ]
  },
  {
    "key": "best_execution_achieved",
    "type": "choice",
    "instructions": "判断该交易是否实现了最佳执行。",
    "criteria": {
      "yes": "交易价格优于或等于市场最优价，执行及时",
      "no": "交易价格明显劣于市场最优价，或执行存在不当延迟",
      "partially": "部分条件满足最佳执行要求"
    },
    "facts": {
      "field": "execution.result",
      "rule": {
        "op": "identity"
      }
    },
    "policy_keywords": [
      "Best Execution",
      "Trading"
    ]
  },
  {
    "key": "trade_suitable",
    "type": "noul",
    "instructions": "判断该笔交易是否适合该客户的投资组合。",
    "criteria": {
      "true": "交易与客户的投资目标、风险承受能力和限制一致",
      "false": "交易与客户的不匹配可能损害其利益"
    },
    "facts": {
      "field": "trade.matches_client_profile",
      "rule": {
        "op": "eq",
        "value": true
      }
    },
    "policy_keywords": [
      "Suitability",
      "Trading"
    ]
  },
  {
